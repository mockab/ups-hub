# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Shared ────────────────────────────────────────────────────────────────────
HUB_URL=http://localhost:8000/api/report

# ── SNMP Agent (agent_snmp.py) ────────────────────────────────────────────────
# JSON array — one object per UPS. Each becomes a separate dashboard card.
# Fields: agent_id (unique slug), label, location, host (NMC IP), community, port
SNMP_DEVICES=[{"agent_id":"srt5000","label":"Smart-UPS SRT 5000","location":"Garage","host":"10.0.0.1","community":"public","port":161}]

# ── NUT / UniFi Agent (agent_unifi.py) ───────────────────────────────────────
AGENT_ID=office-ups
AGENT_LABEL=Office UPS
AGENT_LOC=Office
UPS_NAME=office-ups
UPS_HOST=10.0.0.10
UPS_PORT=3493
